# Copy to .env.local for local development, and set the same values in Vercel.
# Never commit real keys.

# Resend API key (https://resend.com/api-keys). Without it the contact form shows a
# clear "not configured" message instead of sending.
RESEND_API_KEY=

# Where enquiries are delivered.
CONTACT_TO_EMAIL=info@coxcel.com

# Sender address. The coxcel.com domain must be verified in Resend for this to work.
CONTACT_FROM_EMAIL="Coxcel <noreply@coxcel.com>"

# Public base URL used for canonical links, sitemap and social images.
NEXT_PUBLIC_SITE_URL=https://coxcel.com

# --- Analytics and marketing tags ------------------------------------------------
# Leave any value empty to switch that tool off. Tags load only after a visitor accepts
# the cookie banner (the banner only appears when at least one tag is set).
# Values are read at build time: redeploy after changing them.

# Google Search Console verification: the content value of the google-site-verification meta tag.
GOOGLE_SEO=
# Google Tag Manager container ID, for example GTM-XXXXXXX
GOOGLE_GTM=
# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX
GA_TRACKING_ID=
# Meta (Facebook) Pixel ID
FB_PIXEL_ID=
# X (Twitter) Pixel ID
TW_PIXEL_ID=
# Microsoft Clarity project ID
CLARITY_PROJECT_ID=
# Smartlook project key and data region (eu or us)
SMART_LOOK_TRACKING_CODE=
SMART_LOOK_REGION=eu

